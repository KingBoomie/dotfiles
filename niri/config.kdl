spawn-at-startup "noctalia"
spawn-at-startup "lxqt-policykit-agent"
// Apply 1:1 scale to every connected display, including unnamed ones.
spawn-at-startup "sh" "-c" "$HOME/.config/niri/scale-connected-outputs.sh"

input {
    touchpad {
        tap
        natural-scroll
    }

    mouse {}
    trackpoint {}
}

output "eDP-2" {
    scale 1.0
}

// Match these monitors by EDID name, so the rules survive port changes.
output "Samsung Electric Company LS27D70xE HK2L105430" {
    mode "3840x2160@60.000"
    scale 1.0
    position x=0 y=0
}

output "Samsung Electric Company LS27D70xE HK7XA01653" {
    mode "3840x2160@60.000"
    scale 1.0
    position x=3840 y=0
}

output "HDMI-A-2" {
	transform "90"
	mode "1440x2560@60.000"
	scale 1.0
	position x=7680 y=0
	// # rotate 90 deg clockwise
	// # position next to HDMI A 1 on the right
}

debug {
    // Allows notification actions and window activation from Noctalia.
    honor-xdg-activation-with-invalid-serial

    // iGPU render node. Replace with your actual iGPU path.
//    render-drm-device "/dev/dri/by-path/pci-0000:10:00.0-render"
}

window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

binds {
    // Regolith-style launchers.
    Mod+Space hotkey-overlay-title="Launch application" repeat=false { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    // v5 has no separate command launcher; use the unified launcher and its providers.
    Mod+Shift+Space hotkey-overlay-title="Launch application" repeat=false { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Return hotkey-overlay-title="Launch terminal" repeat=false { spawn "alacritty"; }
    Mod+Shift+Return hotkey-overlay-title="Launch browser" repeat=false { spawn "xdg-open" "https://"; }
    Mod+E hotkey-overlay-title="Launch Files" repeat=false { spawn "nautilus" "--new-window"; }
    Mod+Shift+N hotkey-overlay-title="Launch file browser" repeat=false { spawn "nautilus" "--new-window"; }
    Mod+Alt+Space hotkey-overlay-title="Search windows" repeat=false { spawn "noctalia" "msg" "panel-toggle" "launcher" "/win "; }
    Mod+N hotkey-overlay-title="Notifications" repeat=false { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
    Mod+Shift+Slash hotkey-overlay-title="Show keybindings" repeat=false { show-hotkey-overlay; }

    // Regolith-style system and Noctalia panels.
    Mod+B hotkey-overlay-title="Bluetooth settings" repeat=false { spawn "noctalia" "msg" "panel-toggle" "control-center" "bluetooth"; }
    Mod+D hotkey-overlay-title="Display settings" repeat=false { spawn "noctalia" "msg" "panel-toggle" "control-center" "monitor"; }
    Mod+C hotkey-overlay-title="Settings" repeat=false { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+I hotkey-overlay-title="Toggle bar" repeat=false { spawn "noctalia" "msg" "bar-toggle"; }
    Mod+W hotkey-overlay-title="Wi-Fi settings" repeat=false { spawn "noctalia" "msg" "panel-toggle" "control-center" "network"; }

    // Window focus follows Regolith's arrow and vim-key navigation.
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }

    // Window movement follows Regolith's Shift variants.
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }

    // Move the containing workspace/column to another monitor.
    Mod+Ctrl+Shift+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+Up    { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Down  { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+K { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+J { move-column-to-monitor-down; }

    // Workspaces. Niri workspaces are dynamic, so these are best-effort by index.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Ctrl+1 { focus-workspace 11; }
    Mod+Ctrl+2 { focus-workspace 12; }
    Mod+Ctrl+3 { focus-workspace 13; }
    Mod+Ctrl+4 { focus-workspace 14; }
    Mod+Ctrl+5 { focus-workspace 15; }
    Mod+Ctrl+6 { focus-workspace 16; }
    Mod+Ctrl+7 { focus-workspace 17; }
    Mod+Ctrl+8 { focus-workspace 18; }
    Mod+Ctrl+9 { focus-workspace 19; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }
    Mod+Ctrl+Shift+1 { move-window-to-workspace 11; }
    Mod+Ctrl+Shift+2 { move-window-to-workspace 12; }
    Mod+Ctrl+Shift+3 { move-window-to-workspace 13; }
    Mod+Ctrl+Shift+4 { move-window-to-workspace 14; }
    Mod+Ctrl+Shift+5 { move-window-to-workspace 15; }
    Mod+Ctrl+Shift+6 { move-window-to-workspace 16; }
    Mod+Ctrl+Shift+7 { move-window-to-workspace 17; }
    Mod+Ctrl+Shift+8 { move-window-to-workspace 18; }
    Mod+Ctrl+Shift+9 { move-window-to-workspace 19; }

    // Regolith "carry window" behavior: move the window and follow it.
    Mod+Alt+1 { spawn-sh "niri msg action move-window-to-workspace 1 && niri msg action focus-workspace 1"; }
    Mod+Alt+2 { spawn-sh "niri msg action move-window-to-workspace 2 && niri msg action focus-workspace 2"; }
    Mod+Alt+3 { spawn-sh "niri msg action move-window-to-workspace 3 && niri msg action focus-workspace 3"; }
    Mod+Alt+4 { spawn-sh "niri msg action move-window-to-workspace 4 && niri msg action focus-workspace 4"; }
    Mod+Alt+5 { spawn-sh "niri msg action move-window-to-workspace 5 && niri msg action focus-workspace 5"; }
    Mod+Alt+6 { spawn-sh "niri msg action move-window-to-workspace 6 && niri msg action focus-workspace 6"; }
    Mod+Alt+7 { spawn-sh "niri msg action move-window-to-workspace 7 && niri msg action focus-workspace 7"; }
    Mod+Alt+8 { spawn-sh "niri msg action move-window-to-workspace 8 && niri msg action focus-workspace 8"; }
    Mod+Alt+9 { spawn-sh "niri msg action move-window-to-workspace 9 && niri msg action focus-workspace 9"; }
    Mod+Alt+0 { spawn-sh "niri msg action move-window-to-workspace 10 && niri msg action focus-workspace 10"; }
    Mod+Alt+Ctrl+1 { spawn-sh "niri msg action move-window-to-workspace 11 && niri msg action focus-workspace 11"; }
    Mod+Alt+Ctrl+2 { spawn-sh "niri msg action move-window-to-workspace 12 && niri msg action focus-workspace 12"; }
    Mod+Alt+Ctrl+3 { spawn-sh "niri msg action move-window-to-workspace 13 && niri msg action focus-workspace 13"; }
    Mod+Alt+Ctrl+4 { spawn-sh "niri msg action move-window-to-workspace 14 && niri msg action focus-workspace 14"; }
    Mod+Alt+Ctrl+5 { spawn-sh "niri msg action move-window-to-workspace 15 && niri msg action focus-workspace 15"; }
    Mod+Alt+Ctrl+6 { spawn-sh "niri msg action move-window-to-workspace 16 && niri msg action focus-workspace 16"; }
    Mod+Alt+Ctrl+7 { spawn-sh "niri msg action move-window-to-workspace 17 && niri msg action focus-workspace 17"; }
    Mod+Alt+Ctrl+8 { spawn-sh "niri msg action move-window-to-workspace 18 && niri msg action focus-workspace 18"; }
    Mod+Alt+Ctrl+9 { spawn-sh "niri msg action move-window-to-workspace 19 && niri msg action focus-workspace 19"; }

    // Workspace navigation.
    Mod+Tab { focus-workspace-down; }
    Mod+Shift+Tab { focus-workspace-up; }
    Mod+Alt+Right { focus-workspace-down; }
    Mod+Alt+Left  { focus-workspace-up; }

    // Mouse wheel navigation. WheelScroll is mouse-only; TouchpadScroll is separate.
    Mod+WheelScrollDown       { focus-column-right; }
    Mod+WheelScrollUp         { focus-column-left; }
    Mod+Shift+WheelScrollDown { move-column-right; }
    Mod+Shift+WheelScrollUp   { move-column-left; }

    // Niri equivalents for Regolith layout/scratchpad/window-name shortcuts.
    Mod+Ctrl+A hotkey-overlay-title="Overview" repeat=false { toggle-overview; }
    Mod+Ctrl+Space hotkey-overlay-title="Navigate windows by name" repeat=false { spawn "noctalia" "msg" "panel-toggle" "launcher" "/win "; }
    Mod+Comma hotkey-overlay-title="Consume window into column" { consume-window-into-column; }
    Mod+Period hotkey-overlay-title="Expel window from column" { expel-window-from-column; }
    Mod+BackSpace hotkey-overlay-title="Toggle tabbed layout" { toggle-column-tabbed-display; }
    Mod+T hotkey-overlay-title="Toggle tabbed layout" { toggle-column-tabbed-display; }
    Mod+Shift+T hotkey-overlay-title="Switch floating/tiling focus" { switch-focus-between-floating-and-tiling; }
    Mod+F hotkey-overlay-title="Fullscreen window" { fullscreen-window; }
    Mod+Shift+F hotkey-overlay-title="Toggle floating window" { toggle-window-floating; }

    // Column and window sizing.
    Mod+R hotkey-overlay-title="Column width: next preset" { switch-preset-column-width; }
    Mod+Alt+R hotkey-overlay-title="Column width: previous preset" { switch-preset-column-width-back; }
    Mod+Shift+R hotkey-overlay-title="Maximize column" { maximize-column; }
    Mod+M hotkey-overlay-title="Maximize window to edges" { maximize-window-to-edges; }
    Mod+Ctrl+F hotkey-overlay-title="Expand column to available width" { expand-column-to-available-width; }
    Mod+Alt+C hotkey-overlay-title="Center column" { center-column; }
    Mod+Ctrl+C hotkey-overlay-title="Center visible columns" { center-visible-columns; }
    Mod+Ctrl+Shift+R hotkey-overlay-title="Window height: next preset" { switch-preset-window-height; }
    Mod+Alt+Shift+R hotkey-overlay-title="Window height: previous preset" { switch-preset-window-height-back; }
    Mod+Minus hotkey-overlay-title="Column width: shrink" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="Column width: grow" { set-column-width "+10%"; }
    Mod+Shift+Minus hotkey-overlay-title="Window height: shrink" { set-window-height "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="Window height: grow" { set-window-height "+10%"; }
    Mod+Ctrl+Minus hotkey-overlay-title="Window width: shrink" { set-window-width "-10%"; }
    Mod+Ctrl+Equal hotkey-overlay-title="Window width: grow" { set-window-width "+10%"; }
    Mod+Ctrl+BackSpace hotkey-overlay-title="Reset window height" { reset-window-height; }

    // Session shortcuts.
    Mod+Shift+Q hotkey-overlay-title="Close window" repeat=false { close-window; }
    Mod+Escape hotkey-overlay-title="Lock screen" repeat=false { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Shift+E hotkey-overlay-title="Session menu" repeat=false { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Shift+P hotkey-overlay-title="Session menu" repeat=false { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Shift+B hotkey-overlay-title="Session menu" repeat=false { spawn "noctalia" "msg" "panel-toggle" "session"; }
    // Mod+Shift+S hotkey-overlay-title="Suspend" repeat=false { spawn "systemctl" "suspend"; }
    Mod+Shift+C hotkey-overlay-title="Reload config" repeat=false { spawn "niri" "msg" "action" "load-config-file"; }
    Mod+Ctrl+R hotkey-overlay-title="Reload config" repeat=false { spawn "niri" "msg" "action" "load-config-file"; }
    Mod+Alt+Q hotkey-overlay-title="Terminate app" repeat=false { close-window; }

    // Hardware keys.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
    XF86AudioPlay allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioPause allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioStop allow-when-locked=true { spawn "noctalia" "msg" "media" "stop"; }
    XF86AudioPrev allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioNext allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Shift+S hotkey-overlay-title="Annotate screenshot" repeat=false { spawn "noctalia" "msg" "screenshot-annotate"; }
}

window-rule {
    match app-id=r#"^org\.gnome\.Nautilus$"#
    default-column-width { fixed 960; }
}

window-rule {
    match app-id=r#"^Alacritty$"#
    default-column-width {}
}

animations {
    window-open {
        duration-ms 200
        curve "linear"
        custom-shader r"
            float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                if (coords_geo.x < 0.0 || coords_geo.x > 1.0 || coords_geo.y < 0.0 || coords_geo.y > 1.0) return vec4(0.0);
                float progress = niri_clamped_progress;
                float glitch = 1.0 - progress;
                vec2 uv = coords_geo.xy;

                // Horizontal displacement
                float glitch_bar = step(0.90, hash(vec2(floor(uv.y * 20.0), niri_random_seed)));
                float h_offset = glitch_bar * glitch * 0.15 * (hash(vec2(uv.y, niri_random_seed)) - 0.5);
                uv.x += h_offset;

                // RGB split. red leads, cyan trails
                float split = glitch * 0.12;
                vec3 cr = niri_geo_to_tex * vec3(uv + vec2(split * 1.5, split * 0.3), 1.0);
                vec3 cg = niri_geo_to_tex * vec3(uv, 1.0);
                vec3 cb = niri_geo_to_tex * vec3(uv - vec2(split, -split * 0.2), 1.0);

                float r = texture2D(niri_tex, cr.st).r;
                float g = texture2D(niri_tex, cg.st).g;
                float b = texture2D(niri_tex, cb.st).b;
                float a = texture2D(niri_tex, cg.st).a;
                vec3 color = vec3(r, g, b);

                // Noiseyy
                float noise = hash(uv * 500.0 + niri_random_seed) * glitch * 0.30;
                color += noise;

                // Red/magenta tint overlay stronger during glitch
                vec3 cyberpunk_tint = vec3(1.0, 0.2, 0.4);
                color = mix(color, color * cyberpunk_tint, glitch * 0.4);

                // Boost red channel
                color.r *= 1.0 + glitch * 0.3;

                // CRT scanlines with red tint
                float scanline = 1.0 - 0.12 + 0.12 * sin(uv.y * 450.0);
                color *= scanline;

                // Neon edge glow
                float edge = min(min(uv.x, 1.0 - uv.x), min(uv.y, 1.0 - uv.y));
                float glow = smoothstep(0.0, 0.15, edge);
                vec3 neon_red = vec3(1.0, 0.1, 0.3);
                color += neon_red * (1.0 - glow) * glitch * 1.0;

                return vec4(color, a * progress);
            }
        "
    }

    window-close {
        duration-ms 400
        curve "linear"
        custom-shader r"
            float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                if (coords_geo.x < 0.0 || coords_geo.x > 1.0 || coords_geo.y < 0.0 || coords_geo.y > 1.0) return vec4(0.0);
                float progress = niri_clamped_progress;
                vec2 uv = coords_geo.xy;

                // Progressive horizontal bars
                float glitch_bar = step(0.85 - progress * 0.1, hash(vec2(floor(uv.y * 25.0), niri_random_seed + progress)));
                float h_offset = glitch_bar * progress * 0.20 * (hash(vec2(uv.y, niri_random_seed)) - 0.5);
                uv.x += h_offset;

                // Vertical tear effect
                float tear = step(0.97, hash(vec2(floor(uv.x * 40.0), niri_random_seed)));
                uv.y += tear * progress * 0.08 * (hash(vec2(uv.x, niri_random_seed)) - 0.5);

                // RGB split
                float split = progress * 0.15;
                vec3 cr = niri_geo_to_tex * vec3(uv + vec2(split * 1.5, split * 0.4), 1.0);
                vec3 cg = niri_geo_to_tex * vec3(uv + vec2(0.0, progress * 0.02), 1.0);
                vec3 cb = niri_geo_to_tex * vec3(uv - vec2(split, -split * 0.3), 1.0);

                float r = texture2D(niri_tex, cr.st).r;
                float g = texture2D(niri_tex, cg.st).g;
                float b = texture2D(niri_tex, cb.st).b;
                float a = texture2D(niri_tex, cg.st).a;
                vec3 color = vec3(r, g, b);

                // Static noise
                float noise = hash(uv * 600.0 + niri_random_seed + progress * 10.0) * progress * 0.40;
                color += noise;

                // Red/magenta corruption
                vec3 cyberpunk_tint = vec3(1.0, 0.15, 0.35);
                color = mix(color, color * cyberpunk_tint, progress * 0.5);

                // Boost red, crush other channels as it dies
                color.r *= 1.0 + progress * 0.5;
                color.g *= 1.0 - progress * 0.3;
                color.b *= 1.0 - progress * 0.2;

                // Scanlines intensify
                float scanline = 1.0 - (0.08 + progress * 0.1) + (0.08 + progress * 0.1) * sin(uv.y * 500.0);
                color *= scanline;

                // Neon edge glow
                float edge = min(min(uv.x, 1.0 - uv.x), min(uv.y, 1.0 - uv.y));
                float glow = smoothstep(0.0, 0.08, edge);
                vec3 neon_red = vec3(1.0, 0.05, 0.25);
                color += neon_red * (1.0 - glow) * progress * 1.2;

                // Pixel flicker
                float hot_pixel = step(0.990, hash(uv * 300.0 + progress * 5.0));
                color += vec3(1.0, 0.3, 0.5) * hot_pixel * progress;

                return vec4(color, a * (1.0 - progress));
            }
        "
    }
}

include "noctalia.kdl"
